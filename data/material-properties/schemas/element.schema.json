{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "element.schema.json",
  "type": "object",
  "required": [
    "schema",
    "symbol",
    "name",
    "atomicNumber",
    "atomicMassU",
    "referenceState",
    "phases",
    "mechanics",
    "opticalPbr",
    "provenance"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "peercompute.ulg.material-property-bank.element.v0" },
    "symbol": { "type": "string", "pattern": "^[A-Z][a-z]?$" },
    "name": { "type": "string", "minLength": 1 },
    "atomicNumber": { "type": "integer", "minimum": 1, "maximum": 118 },
    "atomicMassU": { "type": "number", "exclusiveMinimum": 0 },
    "isotopeNotes": { "type": "string" },
    "referenceState": {
      "type": "object",
      "required": ["temperatureK", "pressurePa"],
      "additionalProperties": false,
      "properties": {
        "temperatureK": { "type": "number", "minimum": 0 },
        "pressurePa": { "type": "number", "minimum": 0 }
      }
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "temperatureRangeK", "densityKgPerM3"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "enum": ["solid", "liquid", "gas"] },
          "temperatureRangeK": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "number" }
          },
          "densityKgPerM3": { "type": "number", "minimum": 0 },
          "heatCapacityJPerKgK": { "type": "number", "minimum": 0 },
          "thermalConductivityWPerMK": { "type": "number", "minimum": 0 },
          "bulkModulusPa": { "type": ["number", "null"], "minimum": 0 },
          "shearModulusPa": { "type": ["number", "null"], "minimum": 0 },
          "dynamicViscosityPaS": { "type": ["number", "null"], "minimum": 0 },
          "surfaceTensionNPerM": { "type": ["number", "null"], "minimum": 0 }
        }
      }
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "temperatureK"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "temperatureK": { "type": "number", "minimum": 0 },
          "latentHeatJPerKg": { "type": ["number", "null"], "minimum": 0 }
        }
      }
    },
    "mechanics": {
      "type": "object",
      "required": ["mlsMpmMaterialClass", "targetNeighborCount"],
      "additionalProperties": false,
      "properties": {
        "mlsMpmMaterialClass": { "type": "string", "minLength": 1 },
        "targetNeighborCount": { "type": "integer", "minimum": 1 },
        "initialPackingHint": { "type": "string" },
        "spacingPolicy": { "type": "string" }
      }
    },
    "opticalPbr": {
      "type": "object",
      "required": ["baseColorSrgb", "metalness", "roughness"],
      "additionalProperties": false,
      "properties": {
        "baseColorSrgb": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "metalness": { "type": "number", "minimum": 0, "maximum": 1 },
        "roughness": { "type": "number", "minimum": 0, "maximum": 1 },
        "ior": { "type": ["number", "null"], "minimum": 1 },
        "emissiveHint": { "type": "string" }
      }
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["family", "source", "method", "status", "units", "referenceState"],
        "additionalProperties": false,
        "properties": {
          "family": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "method": { "type": "string", "minLength": 1 },
          "status": {
            "type": "string",
            "enum": [
              "precomputed-json-bank",
              "reference-fallback",
              "reduced-estimate",
              "exact-constant"
            ]
          },
          "units": { "type": "string", "minLength": 1 },
          "referenceState": { "type": "string", "minLength": 1 },
          "quality": { "type": "string" },
          "inputHash": { "type": "string" }
        }
      }
    }
  }
}
