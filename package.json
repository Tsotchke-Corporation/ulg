{
  "name": "ulg-triad-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "build:pages": "vite build --config vite.pages.config.mjs && mv docs/pages.html docs/index.html && touch docs/.nojekyll",
    "icc:update": "node scripts/update-icc.mjs",
    "stage:service-assets": "node scripts/stage-service-assets.mjs",
    "status:live": "node scripts/live-status.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test --config tests/playwright.config.mjs"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "vite": "^8.0.16"
  }
}
