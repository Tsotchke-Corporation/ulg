{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ULG Closure Artifact v0.5",
  "type": "object",
  "required": ["closureId", "sourceService", "closureKind", "inputs", "outputs", "execution", "validity", "provenance"],
  "additionalProperties": true,
  "properties": {
    "closureId": { "type": "string", "minLength": 1 },
    "sourceService": { "type": "string", "minLength": 1 },
    "closureKind": { "type": "string", "minLength": 1 },
    "inputs": { "type": "array" },
    "outputs": { "type": "array" },
    "derivatives": { "type": "array" },
    "execution": { "type": "object" },
    "validity": { "type": "object" },
    "uncertainty": { "type": "object" },
    "validation": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "status": { "type": "string" },
        "validationMode": { "type": "string" },
        "outputSemantics": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "schema": { "type": "string" },
            "semanticRole": { "type": "string" },
            "semanticScope": { "type": "string" },
            "scientificScope": { "type": "string" },
            "entryExport": { "type": "string" },
            "entryArgs": { "type": "array" },
            "expectedEntryResult": {},
            "stdout": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "encoding": { "type": "string" },
                "expectedText": { "type": "string" },
                "sha256": { "type": "string" },
                "byteLength": { "type": "integer", "minimum": 0 }
              }
            },
            "scientificValidation": { "type": "boolean" },
            "notes": { "type": "array" }
          }
        }
      }
    },
    "provenance": { "type": "object" }
  }
}
