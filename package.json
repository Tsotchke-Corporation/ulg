{
  "name": "ulg-triad-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "build:pages": "vite build --config vite.pages.config.mjs && mv docs/pages.html docs/index.html && touch docs/.nojekyll",
    "icc:update": "node scripts/update-icc.mjs",
    "stage:service-assets": "node scripts/stage-service-assets.mjs",
    "status:live": "node scripts/live-status.mjs",
    "generate:material-properties": "node scripts/material-properties/generate-material-property-bank.mjs",
    "validate:material-properties": "node scripts/material-properties/validate-material-property-bank.mjs",
    "bench:sph-performance": "node scripts/sph-performance-benchmark.mjs",
    "probe:sph-long-horizon": "node scripts/sph-long-horizon-probe.mjs",
    "probe:sph-visual-matrix": "node scripts/sph-visual-sanity-matrix.mjs",
    "probe:sph-sparse-render-field": "node scripts/sph-sparse-render-field-probe.mjs",
    "probe:sph-sparse-render-field-authoritative": "ULG_SPARSE_FIELD_AUTHORITATIVE_ISOVALUE=1 node scripts/sph-sparse-render-field-probe.mjs",
    "probe:webgpu-primitives": "node scripts/webgpu-parallel-primitives-probe.mjs",
    "probe:resident-product-event-arena": "node scripts/resident-product-event-arena-probe.mjs",
    "probe:coherent-solid-frame": "node scripts/coherent-solid-frame-probe.mjs",
    "probe:coherent-solid-visual": "node scripts/coherent-solid-visual-sequence-probe.mjs",
    "probe:coherent-solid-visual:scene": "ULG_SOLID_REQUIRE_SCENE_BRIDGE=1 node scripts/coherent-solid-visual-sequence-probe.mjs",
    "probe:coherent-solid-production": "ULG_SOLID_PRODUCTION_INJECTION=1 node scripts/coherent-solid-production-bridge-probe.mjs",
    "probe:coherent-solid-production:scene": "ULG_SOLID_PRODUCTION_INJECTION=1 ULG_SOLID_REQUIRE_SCENE_BRIDGE=1 node scripts/coherent-solid-production-bridge-probe.mjs",
    "probe:mounted-resident-authority": "node scripts/mounted-resident-authority-probe.mjs",
    "probe:mounted-resident-authority:ss": "ULG_MOUNTED_RESIDENT_AUTHORITY_REQUIRE_SCHROEDER=1 node scripts/mounted-resident-authority-probe.mjs",
    "probe:resident-neighborhood": "node scripts/resident-neighborhood-consumer-chain-probe.mjs",
    "probe:sph-gas-cell-eos": "node scripts/sph-spatial-gas-cell-eos-gpu-probe.mjs",
    "probe:reaction-direct-soa": "node scripts/sph-reaction-direct-soa-probe.mjs",
    "probe:schroeder-sparse-hierarchy": "node scripts/schroeder-sparse-hierarchy-probe.mjs",
    "probe:native-refraction-science": "node scripts/native-refraction-science-probe.mjs",
    "test:sph-standard-visual": "ULG_VISUAL_MATRIX_STANDARD=1 ULG_VISUAL_MATRIX_CAPTURE_FRAMES=1 ULG_PROBE_GPU_PROFILE=1 ULG_PROBE_CHROMIUM_ARGS='--use-angle=vulkan --enable-features=Vulkan,UseSkiaRenderer' node scripts/sph-visual-sanity-matrix.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test --config tests/playwright.config.mjs",
    "test:sph-visual": "ULG_SPH_VISUAL_CAPTURE=1 PLAYWRIGHT_ENABLE_UNSAFE_WEBGPU=1 playwright test --config tests/playwright.config.mjs --grep \"SPH phase visual sequence\"",
    "test:physics-atomics": "node --test tests/physicsBehaviorInvariants.test.mjs",
    "test:physics-liquid-atomic": "ULG_RUN_LONG_LIQUID_ATOMIC=1 node --test tests/physicsBehaviorInvariants.test.mjs"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "three": "^0.184.0",
    "three-webgpu-marching-cubes": "file:../webgpu-marching-cubes"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "vite": "^8.0.16"
  }
}
