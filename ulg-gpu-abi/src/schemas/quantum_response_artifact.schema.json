{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ULG Quantum Response Artifact v0.5",
  "type": "object",
  "required": ["artifactId", "sourceService", "taskKind", "inputHash", "method", "representation", "outputs", "validation", "provenance"],
  "additionalProperties": true,
  "properties": {
    "artifactId": { "type": "string", "minLength": 1 },
    "sourceService": { "const": "moonlab" },
    "taskKind": { "type": "string", "minLength": 1 },
    "inputHash": { "type": "string", "minLength": 1 },
    "method": { "type": "string", "minLength": 1 },
    "representation": { "type": "string", "minLength": 1 },
    "outputs": { "type": "object" },
    "uncertainty": { "type": "object" },
    "validation": { "type": "object" },
    "provenance": { "type": "object" }
  }
}
