{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ULG Compute Service Manifest v0.5",
  "type": "object",
  "required": ["serviceId", "version", "runtime", "entry", "childWorkers", "resources", "capabilities", "abi", "validation"],
  "additionalProperties": true,
  "properties": {
    "serviceId": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "runtime": {
      "enum": ["wasm", "webgpu", "wasm-webgpu", "js", "native-bridge"]
    },
    "entry": {
      "type": "object",
      "required": ["workerModule"],
      "properties": {
        "workerModule": { "type": "string", "minLength": 1 },
        "loaderModule": { "type": "string" },
        "wasmModule": { "type": "string" },
        "initExport": { "type": "string" },
        "serviceAssets": {
          "type": "object",
          "required": ["serviceId", "rootPath", "baseUrl"],
          "additionalProperties": true,
          "properties": {
            "serviceId": { "type": "string", "minLength": 1 },
            "rootPath": { "type": "string", "minLength": 1 },
            "baseUrl": { "type": "string", "minLength": 1 },
            "loaderModule": { "type": "string" },
            "wasmModule": { "type": "string" },
            "locateFileProbe": { "type": "string" },
            "required": {
              "type": "array",
              "items": { "type": "string" }
            },
            "files": { "type": "object" }
          }
        }
      }
    },
    "childWorkers": {
      "type": "object",
      "required": ["allowed", "maxChildren", "allowedModules", "sameOriginOnly"],
      "properties": {
        "allowed": { "type": "boolean" },
        "maxChildren": { "type": "integer", "minimum": 0 },
        "allowedModules": {
          "type": "array",
          "items": { "type": "string" }
        },
        "sameOriginOnly": { "const": true }
      }
    },
    "resources": { "type": "object" },
    "capabilities": {
      "type": "array",
      "items": { "type": "string" }
    },
    "taskKinds": {
      "type": "array",
      "items": { "type": "string" }
    },
    "abi": {
      "type": "object",
      "required": ["ulgIrVersion", "gpuAbiVersion", "supportedDTypes", "supportedLayouts"]
    },
    "validation": {
      "type": "object",
      "required": ["requiresCpuReference", "toleranceProfile", "parityModes"]
    }
  }
}
