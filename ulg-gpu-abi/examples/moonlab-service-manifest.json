{
  "serviceId": "moonlab",
  "version": "0.5.0-demo",
  "runtime": "wasm",
  "entry": {
    "workerModule": "./workers/moonlab.service.worker.js",
    "loaderModule": "/service-assets/moonlab/moonlab.js",
    "wasmModule": "/service-assets/moonlab/moonlab.wasm",
    "serviceAssets": {
      "serviceId": "moonlab",
      "rootPath": "/service-assets",
      "baseUrl": "/service-assets/moonlab/",
      "loaderModule": "/service-assets/moonlab/moonlab.js",
      "wasmModule": "/service-assets/moonlab/moonlab.wasm",
      "locateFileProbe": "moonlab.wasm",
      "coreProbeWorkerModule": "./workers/moonlab-core-probe.worker.js",
      "required": ["loaderModule", "wasmModule"],
      "files": {
        "loaderModule": "moonlab.js",
        "wasmModule": "moonlab.wasm"
      }
    }
  },
  "childWorkers": {
    "allowed": true,
    "maxChildren": 4,
    "allowedModules": ["./workers/moonlab.child.worker.js", "./workers/moonlab-core-probe.worker.js"],
    "sameOriginOnly": true
  },
  "resources": {
    "maxWasmMemoryBytes": 67108864,
    "maxGpuMemoryBytes": 33554432,
    "maxCpuWorkers": 4,
    "maxTaskMs": 30000
  },
  "capabilities": [
    "ulg.quantum.response",
    "ulg.parity.cpu_webgpu",
    "ulg.tensor.contract"
  ],
  "taskKinds": ["moonlab.quantum.response"],
  "abi": {
    "ulgIrVersion": "0.5",
    "gpuAbiVersion": "0.5",
    "supportedDTypes": ["f32", "complex64"],
    "supportedLayouts": ["soa", "interleaved", "row-major"]
  },
  "validation": {
    "requiresCpuReference": true,
    "toleranceProfile": "quantum-response-demo",
    "parityModes": ["wasm-reference", "js-dummy-reference"]
  }
}
